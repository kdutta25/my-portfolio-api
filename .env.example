# Optional: override default 3001
# PORT=3001

# If nginx (or similar) forwards https://your-domain.com/api/* to this app, set:
# API_BASE_PATH=/api
# Then VITE_CONTENT_API_BASE_URL in the portfolio must be https://your-domain.com/api (no trailing slash).

# Comma-separated browser origins allowed to fetch site content (CORS).
# SITE_CONTENT_CORS_ORIGINS=http://localhost:4044,https://www.kaustubhdutta.com
